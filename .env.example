# Copy this file to `.env` and fill in the values you need:
#   cp .env.example .env
# Never commit your `.env` file.

###############################################################################
# LLM / embedding provider (pick one or more)
###############################################################################

# --- OpenRouter ---
# OPENROUTER_API_KEY=your-api-key

# --- LiteLLM gateway ---
# LITELLM_GATEWAY_API_BASE=https://your-gateway.example.com
# LITELLM_GATEWAY_API_KEY=your-gateway-key

# --- Azure AI Foundry (default adapter) ---
# AZURE_AI_FOUNDRY_ENDPOINT=https://your-foundry-endpoint.openai.azure.com/
# API_KEY=your-api-key

# --- Azure OpenAI Service (legacy adapter) ---
# AZURE_ENDPOINT=https://your-openai-endpoint.openai.azure.com/
# API_KEY=your-api-key

# Azure adapters: API_KEY can be omitted after `az login` if the helper is installed:
#   pip install "azure_authentication@git+https://github.com/soda-lmu/azure-auth-helper-python.git"

###############################################################################
# Download shared PDFs / embeddings from Azure Datalake (optional)
###############################################################################
# If AZURE_STORAGE_ACCOUNT_URL is unset, the data lake is skipped.
# AZURE_STORAGE_ACCOUNT_URL=https://<your-storage-account>.blob.core.windows.net/
# AZURE_STORAGE_SAS_TOKEN=your-sas-token

###############################################################################
# MLflow experiment tracking (optional, defaults to ./mlruns)
###############################################################################
# Allow the local file store (./mlruns), which recent MLflow versions deprecate
# MLFLOW_ALLOW_FILE_STORE=true

# Sync with Azure Databricks MLflow tracking server (optional)
# MLFLOW_TRACKING_URI=databricks
# DATABRICKS_HOST=https://<your-databricks-instance>.azuredatabricks.net/
# DATABRICKS_TOKEN=personal-access-token
